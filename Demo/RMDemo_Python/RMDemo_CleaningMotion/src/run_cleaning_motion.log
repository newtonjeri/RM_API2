unknown argument: '--mode'

USAGE
    # offline — no arm, no network; everything except dispatch
    python3 run_cleaning_motion.py --motion ../motions/<file> --dry-run

    # plumbing selftest, no motion file needed
    python3 run_cleaning_motion.py --selftest --dry-run
    python3 run_cleaning_motion.py --selftest --mode SIM

    # a real motion
    python3 run_cleaning_motion.py --motion ../motions/<file> --mode SIM
    python3 run_cleaning_motion.py --motion ../motions/<file> --mode REAL \
            --speed 0.25
    python3 run_cleaning_motion.py --motion ../motions/<file> --mode REAL \
            --speeds 0.25,0.35,0.45

    python3 run_cleaning_motion.py --list        # what is in motions/

FLAGS
    --motion PATH     the cleaning-motion file to run
    --format NAME     force an adapter instead of sniffing the file
    --side left|right override the side the motion declares
    --speed X         one speed [m/s], off-ladder
    --speeds a,b,c    an explicit ladder, run in order, stopping on failure
    --line-acc X      pin the linear acceleration instead of deriving it
    --angular-speed X pin the angular cap instead of coupling it to v
    --coupling K      omega_cap = K * v (default from the concept tree)
    --allow-over-limit  dispatch a rung the J4 screen refused. E-stop in hand.
    --dry-run         offline only: load, convert, screen, print. No arm.
    --selftest        use a synthetic in-box square instead of a motion file
    --list            list the motion files and exit
    --no-record       skip the UDP recording (it is on by default)



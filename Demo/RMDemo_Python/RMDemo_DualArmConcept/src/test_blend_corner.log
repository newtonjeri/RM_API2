  RM_SYNC_LEAD_MS=N                            pole head start on sync steps
  RM_ARM_TIMEOUT_S / RM_LIFT_TIMEOUT_S         arrival waits (default 40 / 60)
  RM_HAND_DWELL_S / RM_HAND_MODBUS_DEVICE / RM_KEEP_MODBUS=1
  RM_ALLOW_NO_UDP=1 / RM_EMU_TIME_SCALE


